# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# amostras da API do SGP (contêm dados do cliente)
sgp-amostra*.json

# banco local — recriado por 'npm run db:reset' + 'npm run db:seed'
*.db
*.db-journal
*.db-wal
*.db-shm

# skills de editor instaladas pelo 'prisma init' — recriadas automaticamente
.agents/
.windsurf/
.claude/skills/
skills-lock.json
