# Banco local (Bloco 1)
DATABASE_URL="file:./prisma/dev.db"

# Marque "1" só depois que o site estiver servido por HTTPS de verdade (nginx
# + certbot). Antes disso, deixe vazio ou "0" — com "1" sem HTTPS o cookie de
# sessão nunca volta ao servidor e ninguém consegue ficar logado.
HTTPS_ATIVO=""

# ---------------------------------------------------------------------------
# BLOCO 2 — Integração com o SGP
#
# Nunca commite este arquivo preenchido. Copie para `.env` e preencha lá.
# O `.env` já está no .gitignore.
# ---------------------------------------------------------------------------

# URL base da instância, sem barra no final. Ex.: https://demo.sgp.net.br
SGP_URL=""

# Credenciais de integração geradas no painel do SGP
SGP_APP=""
SGP_TOKEN=""

# Opcional: usuário/senha, quando o endpoint exigir em vez de app+token
SGP_USUARIO=""
SGP_SENHA=""

# Recepcao de posicoes do rastreador (/api/rastreador)
# Sem este valor definido, o endpoint fica desligado.
RASTREADOR_SEGREDO=""

# ---------------------------------------------------------------------------
# BLOCO 3 — Rastreamento (Traccar)
#
# A plataforma rastreamentopopular.com roda Traccar 6.3.
#
# A conta da operacao NAO expoe geracao de token no painel, entao a conexao e
# pelo mesmo usuario e senha usados para entrar no site. Preencha os dois
# campos abaixo e deixe TRACCAR_TOKEN vazio.
# ---------------------------------------------------------------------------
TRACCAR_URL="https://rastreamentopopular.com"
TRACCAR_USUARIO=""
TRACCAR_SENHA=""

# So preencha se um dia o painel passar a oferecer token (tem prioridade sobre
# usuario e senha).
TRACCAR_TOKEN=""
