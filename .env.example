# Banco local (Bloco 1)
DATABASE_URL="file:./prisma/dev.db"

# ---------------------------------------------------------------------------
# BLOCO 2 — Integração com o SGP
#
# Nunca commite este arquivo preenchido. Copie para `.env` e preencha lá.
# O `.env` já está no .gitignore.
# ---------------------------------------------------------------------------

# URL base da instância, sem barra no final. Ex.: https://demo.sgp.net.br
SGP_URL=""

# Credenciais de integração geradas no painel do SGP
SGP_APP=""
SGP_TOKEN=""

# Opcional: usuário/senha, quando o endpoint exigir em vez de app+token
SGP_USUARIO=""
SGP_SENHA=""

# Recepcao de posicoes do rastreador (/api/rastreador)
# Sem este valor definido, o endpoint fica desligado.
RASTREADOR_SEGREDO=""

# ---------------------------------------------------------------------------
# BLOCO 3 — Rastreamento (Traccar)
#
# A plataforma rastreamentopopular.com roda Traccar 6.3.
# Gere o token em: Configuracoes -> Conta -> Token
# ---------------------------------------------------------------------------
TRACCAR_URL="https://rastreamentopopular.com"
TRACCAR_TOKEN=""

# Alternativa ao token (menos recomendado)
TRACCAR_USUARIO=""
TRACCAR_SENHA=""
